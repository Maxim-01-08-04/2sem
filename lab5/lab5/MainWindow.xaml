<Window x:Class="lab5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        
        <Style x:Key="RoomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFE0E0E0"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Background="#FFDDDDDD">
            <Button Content="Добавить комнату" Click="AddRoom_Click" 
                   Style="{StaticResource RoomButtonStyle}" FontSize="12"/>
            <Button x:Name="ThemeToggleButton" Content="Темная тема" Click="ToggleTheme_Click" 
                   Style="{StaticResource RoomButtonStyle}" FontSize="12" Margin="10,0,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="RoomsPanel" Margin="10"/>
        </ScrollViewer>

        <StatusBar Grid.Row="2" Background="#FFE0E0E0">
            <TextBlock x:Name="StatusText" Text="Готово"/>
        </StatusBar>
    </Grid>
</Window>
