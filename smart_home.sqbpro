<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="smart_home.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="0"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1309"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Apartments" custom_title="0" dock_id="2" table="4,10:mainApartments"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000002fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000000000000000fb000000160064006f0063006b00420072006f00770073006500320100000000ffffffff0000012800ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE Apartments (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    ApartmentNumber TEXT NOT NULL UNIQUE,
    Description TEXT NOT NULL
);

CREATE TABLE Rooms (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    ApartmentId INTEGER NOT NULL,
    Name TEXT NOT NULL,
    FOREIGN KEY (ApartmentId) REFERENCES Apartments(Id)
);

CREATE TABLE RoomInfo (
    RoomId INTEGER PRIMARY KEY,
    Area REAL NOT NULL,
    Temperature REAL NOT NULL,
    IsLightOn INTEGER NOT NULL CHECK (IsLightOn IN (0,1)),
    FOREIGN KEY (RoomId) REFERENCES Rooms(Id)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
